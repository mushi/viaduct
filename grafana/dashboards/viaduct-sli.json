      "pluginVersion": "13.2.0-28666480772",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "1 - (\n  sum(increase(probe_failures_total{reason!=\"socks_down\"}[$__range]))\n  /\n  (sum(increase(probe_attempts_total[$__range])) - sum(increase(probe_failures_total{reason=\"socks_down\"}[$__range])))\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Availability SLI",
      "type": "stat"
    },
