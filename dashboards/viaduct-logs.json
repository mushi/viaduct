    {
      "type": "stat",
      "title": "Break-glass root attempts",
      "description": "Calls to `sys/generate-root/*`. This is the documented recovery for re-provisioning Vault and is gated by a 3-of-5 recovery-key threshold held offline \u2014 so it is rare, deliberate, and should always correlate with something you were doing. Unexplained, it is an incident.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({node=~\"$node\", unit=\"vault.service\"} |= `generate-root` | json p=\"request.path\", t=\"type\" | t = `request` | p =~ `sys/generate-root.*` [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true
        }
      ],
