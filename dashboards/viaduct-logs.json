{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "Viaduct — Fleet Logs",
  "uid": "viaduct-fleet-logs",
  "tags": ["viaduct", "logs", "loki"],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_LOKI",
        "label": "Loki datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "type": "query",
        "name": "node",
        "label": "Node",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(node)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "query",
        "name": "level",
        "label": "Level",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(level)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search (regex, case-insensitive)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by node",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } }, "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (node) (count_over_time({node=~\"$node\"} |~ \"(?i)$search\" [$__interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors & warnings by node",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }, "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (node) (count_over_time({node=~\"$node\", level=~\"err|crit|alert|emerg|warning\"} |~ \"(?i)$search\" [$__interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fleet logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 15, "w": 18, "x": 0, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{node=~\"$node\", level=~\"$level\", job=\"systemd-journal\"} |~ \"(?i)$search\"",
          "maxLines": 1000
        }
      ]
    },
    {
      "id": 4,
      "title": "Top units by volume (range)",
      "type": "table",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 15, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [ { "id": "custom.width", "value": 80 }, { "id": "displayName", "value": "lines" } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "lines", "desc": true } ] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(15, sum by (unit) (count_over_time({node=~\"$node\"} |~ \"(?i)$search\" [$__range])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "unit": "unit", "Value": "lines" } } }
      ]
    }
  ]
}
